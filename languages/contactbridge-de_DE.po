msgstr "Diagnose"

#: includes/class-tscb-mail-admin.php:183
msgid "Custom SMTP"
msgstr "Eigener SMTP-Versand"

#: includes/class-tscb-mail-admin.php:183
msgid "WordPress mail"
msgstr "WordPress-Mailversand"

#: includes/class-tscb-mail-admin.php:184
msgid "Test message"
msgstr "Testnachricht"

#: includes/class-tscb-mail-admin.php:184
